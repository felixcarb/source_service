# .env.test

# FTP
FTP_TEST_HOST="localhost"
FTP_TEST_PORT=21
FTP_TEST_USERNAME="ftpuser"
FTP_TEST_PASSWORD="ftppass"
FTP_TEST_TIMEOUT=60
FTP_TEST_PASSIVE=true

# SFTP
SFTP_TEST_HOST="localhost"
SFTP_TEST_PORT=2222
SFTP_TEST_USERNAME="sftpuser"
SFTP_TEST_PASSWORD="sftppass"
SFTP_TEST_PATH="/data"

# S3 (LocalStack)
S3_TEST_BUCKET="test-bucket"
S3_TEST_ACCESS_KEY="test"
S3_TEST_SECRET_KEY="test"
S3_TEST_REGION="us-east-1"
S3_TEST_PREFIX="test/"
S3_TEST_ENDPOINT_URL="http://localhost:4566"

# SMB
SMB_TEST_HOST="localhost"
SMB_TEST_PORT=445
SMB_TEST_USERNAME="smbuser"
SMB_TEST_PASSWORD="smbpass"
SMB_TEST_SHARE="share"
SMB_TEST_PATH="/share"

# API
API_TEST_URL="http://localhost:8000/documents"
API_TEST_HEADERS='{"Accept": "application/json"}'
